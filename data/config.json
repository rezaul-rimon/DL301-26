{
    "config_version": 1,

    "device": {
        "name": "DL301-26",
        "poll_interval_ms": 2000
    },

    "rs485": {
        "rx_pin": 14,
        "tx_pin": 13,
        "de_re_pin": -1
    },

    "sensors": [

        {
            "id": 1,
            "name": "AWS Wind Speed",

            "modbus": {
                "slave_id": 1,
                "baud_rate": 9600,
                "parity": "N",
                "data_bits": 8,
                "stop_bits": 1,
                "retry_attempts": 3,
                "receive_timeout_ms": 500,
                "min_interval_ms": 2000
            },

            "channels": [
                {
                    "enabled": true,
                    "alias": "wind_speed",
                    "description": "Wind speed",
                    "unit": "m/s",
                    "register_type": "holding",
                    "address": "0x0000",
                    "data_type": "int16",
                    "scale_factor": 0.1,
                    "offset": 0.0
                }
            ]
        },

        {
            "id": 2,
            "name": "AWS Wind Direction",

            "modbus": {
                "slave_id": 2,
                "baud_rate": 9600,
                "parity": "N",
                "data_bits": 8,
                "stop_bits": 1,
                "retry_attempts": 3,
                "receive_timeout_ms": 500,
                "min_interval_ms": 2000
            },

            "channels": [
                {
                    "enabled": true,
                    "alias": "wind_direction",
                    "description": "Wind direction",
                    "unit": "degrees",
                    "register_type": "holding",
                    "address": "0x0000",
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                }
            ]
        },

        {
            "id": 3,
            "name": "AWS PTH",

            "modbus": {
                "slave_id": 3,
                "baud_rate": 9600,
                "parity": "N",
                "data_bits": 8,
                "stop_bits": 1,
                "retry_attempts": 3,
                "receive_timeout_ms": 500,
                "min_interval_ms": 2000,

                "batch_read": {
                    "enabled": true,
                    "address": "0x0000",
                    "quantity": 3,
                    "register_type": "holding"
                }
            },

            "channels": [
                {
                    "enabled": true,
                    "alias": "pressure",
                    "description": "Air pressure",
                    "unit": "hPa",
                    "register_index": 0,
                    "data_type": "uint16",
                    "scale_factor": 0.1,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "temperature",
                    "description": "Ambient temperature",
                    "unit": "C",
                    "register_index": 1,
                    "data_type": "uint16",
                    "scale_factor": 0.1,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "humidity",
                    "description": "Relative humidity",
                    "unit": "%RH",
                    "register_index": 2,
                    "data_type": "uint16",
                    "scale_factor": 0.1,
                    "offset": 0.0
                }
            ]
        },
        
        {
            "id": 5,
            "name": "BGT-LD Lightning Detector",

            "modbus": {
                "slave_id": 5,
                "baud_rate": 9600,
                "parity": "N",
                "data_bits": 8,
                "stop_bits": 1,
                "retry_attempts": 3,
                "receive_timeout_ms": 500,
                "min_interval_ms": 2000,

                "batch_read": {
                    "enabled": true,
                    "address": "0x0000",
                    "quantity": 12,
                    "register_type": "input"
                }
            },

            "channels": [
                {
                    "enabled": true,
                    "alias": "verify_status",
                    "description": "Sensor verify status",
                    "unit": "",
                    "register_index": 0,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "strike_last_read",
                    "description": "Last strike timestamp",
                    "unit": "",
                    "register_index": 1,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "noise_last_read",
                    "description": "Last noise timestamp",
                    "unit": "",
                    "register_index": 2,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "disturber_last_read",
                    "description": "Last disturber timestamp",
                    "unit": "",
                    "register_index": 3,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "distance_km",
                    "description": "Distance to last strike",
                    "unit": "km",
                    "register_index": 4,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "strike_energy",
                    "description": "Last strike energy",
                    "unit": "",
                    "register_index": 5,
                    "data_type": "uint32",
                    "word_order": "high_low",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "strikes_10min",
                    "description": "Strikes in last 10 minutes",
                    "unit": "",
                    "register_index": 7,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "strikes_30min",
                    "description": "Strikes in last 30 minutes",
                    "unit": "",
                    "register_index": 8,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "strikes_60min",
                    "description": "Strikes in last 60 minutes",
                    "unit": "",
                    "register_index": 9,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "noise_60min",
                    "description": "Noise events in last 60 minutes",
                    "unit": "",
                    "register_index": 10,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                },
                {
                    "enabled": true,
                    "alias": "disturber_60min",
                    "description": "Disturber events in last 60 minutes",
                    "unit": "",
                    "register_index": 11,
                    "data_type": "uint16",
                    "scale_factor": 1.0,
                    "offset": 0.0
                }
            ]
        }

    ]
}